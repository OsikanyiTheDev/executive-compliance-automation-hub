# ============================================================
# Environment Variables — Executive Compliance Automation Hub
# ============================================================
# Copy this file to '.env' and customize for your environment.
# NEVER commit '.env' to Git!
# ============================================================

# ============================================================
# N8N — General
# ============================================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Timezone (set to your local timezone)
# Examples: America/New_York, Europe/London, Africa/Lagos
GENERIC_TIMEZONE=UTC
TZ=UTC

# Encryption key (REQUIRED for production)
# Generate with: openssl rand -base64 32
N8N_ENCRYPTION_KEY=dev-encryption-key-change-in-production-please

# Basic auth (prevents unauthorized access in dev)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin

# ============================================================
# DATABASE — PostgreSQL
# ============================================================
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=n8n_dev_password

# ============================================================
# AI — Anthropic Claude (used in v0.6+)
# ============================================================
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================================
# AWS — (used in v0.9+)
# ============================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=executive-compliance-documents

# ============================================================
# GOOGLE WORKSPACE — (used in v0.4+)
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# EMAIL — (used in v0.3+)
# ============================================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
